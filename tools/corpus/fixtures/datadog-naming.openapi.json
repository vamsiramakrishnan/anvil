  "paths": {
    "/api/v2/usage/admin/temporary-grant-requests/{request_id}/decision": {
      "post": {
        "description": "Approve or deny the submitted terms, which are immutable. Approval atomically writes the grant, audit record, and request decision. An expired request can't be approved. Requires the Billing Edit permission. Requires an authenticated human user. Service-account credentials aren't supported. Request status remains approved after the grant's expiry, revocation, or replacement.",
        "operationId": "UpdateTemporaryGrantRequest",
        "parameters": [
          {
            "description": "The temporary grant request UUID.",
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "description": "The request UUID.",
              "example": "12345678-1234-1234-1234-123456789012",
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "default": {
                  "value": {
                    "data": {
                      "attributes": {
                        "decision": "approved"
                      },
                      "id": "12345678-1234-1234-1234-123456789012",
                      "type": "temporary_grant_requests"
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/TemporaryGrantRequestDecisionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "default": {
                    "value": {
                      "data": {
                        "attributes": {
                          "created_at": "2028-02-16T00:00:00Z",
                          "decided_at": "2028-02-16T01:00:00Z",
                          "decided_by_user_id": "23456789-2345-2345-2345-234567890123",
                          "entity_key": "user_handle:jane@example.com",
                          "expires_at": "2028-03-01T00:00:00Z",
                          "justification": "Credits needed to finish the incident investigation.",
                          "quota_namespace": "ai_credits",
                          "requested_by_user_id": "12345678-1234-1234-1234-123456789012",
                          "status": "approved",
                          "total": 200
                        },
                        "id": "34567890-3456-3456-3456-345678901234",
                        "type": "temporary_grant_requests"
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/TemporaryGrantRequestResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JSONAPIErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JSONAPIErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JSONAPIErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JSONAPIErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JSONAPIErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequestsResponse"
          }
        },
        "security": [
          {
            "apiKeyAuth": [],
            "appKeyAuth": []
          },
          {
            "AuthZ": [
              "billing_edit"
            ]
          }
        ],
        "summary": "Decide a temporary grant request",
        "tags": [
          "Usage Metering"
