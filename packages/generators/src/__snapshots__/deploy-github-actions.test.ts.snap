// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateGithubActionsWorkflow > emits one parseable workflow, read-only, triggered on push/PR/dispatch, and matches the snapshot 1`] = `
"# Generated by Anvil — release gates and deployment plan for "payments".
# This workflow builds, proves, and PLANS. It never pushes an image, never
# applies a manifest, and holds no cluster or registry credential. Promote
# the reviewed plan artifact with a separate, gated job of your own.
# Copy to .github/workflows/ in the repository that holds this bundle.
name: anvil release plan — payments
on:
  push:
    branches:
      - main
  pull_request: {}
  workflow_dispatch: {}
permissions:
  contents: read
env:
  ANVIL_CLI_PACKAGE: \${{ vars.ANVIL_CLI_PACKAGE }}
  ANVIL_IMAGE_REPOSITORY: \${{ vars.ANVIL_IMAGE_REPOSITORY }}
  ANVIL_KUBERNETES_NAMESPACE: \${{ vars.ANVIL_KUBERNETES_NAMESPACE || 'anvil' }}
jobs:
  gates:
    name: Gates and plan (never applies)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "22"
      - name: Install the pinned Anvil CLI
        run: |-
          test -n "$ANVIL_CLI_PACKAGE" || { echo "Set the ANVIL_CLI_PACKAGE repository variable to a reviewed Anvil CLI package spec."; exit 1; }
          npm install --global "$ANVIL_CLI_PACKAGE"
          anvil --version
      - name: Static assurance (certify)
        run: anvil certify .
      - name: Loopback self-test
        run: anvil selftest .
      - name: Surface conformance
        run: anvil conformance .
      - name: Build the runtime image (not pushed by this workflow)
        run: docker build -f deploy/Dockerfile -t "payments-tools:$GITHUB_SHA" .
      - name: Render the Kubernetes plan
        run: |-
          test -n "$ANVIL_IMAGE_REPOSITORY" || { echo "Set the ANVIL_IMAGE_REPOSITORY repository variable (registry/repo) the plan is rendered for."; exit 1; }
          mkdir -p plan
          anvil deploy kubernetes . --image "$ANVIL_IMAGE_REPOSITORY:$GITHUB_SHA" --namespace "$ANVIL_KUBERNETES_NAMESPACE" --out plan/kubernetes
          kubectl kustomize plan/kubernetes > plan/kubernetes.rendered.yaml
          if grep -q REPLACE_WITH_ plan/kubernetes.rendered.yaml; then echo "Unfilled REPLACE_WITH_ scaffold in the rendered manifest; supply the operator inputs."; exit 1; fi
          anvil deploy kubernetes . > plan/kubernetes.plan.txt
      - name: Record the Cloud Run plan
        run: anvil deploy cloud-run . > plan/cloud-run.plan.txt
      - name: Publish the plan for review
        uses: actions/upload-artifact@v4
        with:
          name: anvil-release-plan-\${{ github.sha }}
          path: plan
          if-no-files-found: error
          retention-days: 30
"
`;
