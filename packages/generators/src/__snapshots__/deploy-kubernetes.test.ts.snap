exports[`generateKubernetesDeploy > matches the reviewed snapshot for the reference payments bundle 1`] = `
"# Generated by Anvil — kustomization for "payments" (payments-tools).
# Anvil emits this manifest; it never applies it. Regenerate with anvil, never hand-edit.
# Single owner of the image, the namespace, and the labels. Render with
# \`kubectl kustomize deploy/kubernetes\`; apply only the reviewed render.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: anvil
resources:
  - serviceaccount.yaml
  - configmap.yaml
  - operator-env.yaml
  - deployment.yaml
  - service.yaml
images:
  - name: anvil-runtime
    newName: REPLACE_WITH_REGISTRY/payments-tools
    newTag: REPLACE_WITH_IMAGE_TAG
"
`;

exports[`generateKubernetesDeploy > matches the reviewed snapshot for the reference payments bundle 2`] = `
"# Generated by Anvil — runtime ServiceAccount for "payments" (payments-tools).
# Anvil emits this manifest; it never applies it. Regenerate with anvil, never hand-edit.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: payments-tools
  labels:
    app.kubernetes.io/name: payments-tools
    app.kubernetes.io/part-of: anvil
