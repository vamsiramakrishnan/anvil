{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "authentication": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "oidc",
            "google_service_account",
            "google_iap",
            "jwt_bridge"
          ]
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "jwksUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "requiredScopes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "tokenType": {
          "type": "string",
          "enum": [
            "at+jwt",
            "JWT"
          ]
        }
      },
      "required": [
        "provider",
        "issuer",
        "audience",
        "jwksUri"
      ],
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "properties": {
        "tenant": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "fixed"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "required": [
                "source",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "claim"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "allowed": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              "required": [
                "source",
                "claim",
                "allowed"
              ],
              "additionalProperties": false
            }
          ]
        },
        "groupsClaim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "upstreamScopes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "subjects": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "required": [
        "tenant"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "adapter": {
          "default": "rules",
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "timeoutMs": {
          "default": 3000,
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "service": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "operations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "effect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny"
                ]
              },
              "subjects": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "groups": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              },
              "constraints": {
                "default": [],
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "tenant_equals"
                        },
                        "input": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        }
                      },
                      "required": [
                        "kind",
                        "input"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "number_max"
                        },
                        "input": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "maximum": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "kind",
                        "input",
                        "maximum"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "requireConfirmation": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "service",
              "operations",
              "effect"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "authentication",
    "mapping",
    "authorization"
  ],
  "additionalProperties": false
}
