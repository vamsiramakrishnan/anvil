{
  "$id": "https://vamsiramakrishnan.github.io/anvil/schemas/anvil-manifest.schema.json",
  "title": "Anvil manifest",
  "description": "The semantic overlay a reviewer writes for a compiled source: per-operation effect, risk, idempotency, confirmation, naming, auth, retries, and pagination; authored workflows, capability reviews, and query templates. Keys are strict — an unknown key is a compile error. Cross-field rules are enforced by `anvil compile`, not by this schema.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "service": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "none",
                "api_key",
                "basic",
                "oauth2_client_credentials",
                "oauth2_authorization_code",
                "oauth2_on_behalf_of",
                "jwt_bearer",
                "mtls",
                "custom_header",
                "workload_identity"
              ]
            },
            {
              "type": "string",
              "const": "oauth2"
            }
          ]
        },
        "credential_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z](?:[a-z0-9_]{0,62}[a-z0-9])?$"
        },
        "principal": {
          "type": "string",
          "enum": [
            "anonymous",
            "service",
            "end_user",
            "delegated",
            "impersonation"
          ]
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "audience": {
          "type": "string"
        },
        "carrier": {
          "type": "object",
          "properties": {
            "in": {
              "type": "string",
              "enum": [
                "header",
                "query"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "scheme": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "in",
            "name"
          ],
          "additionalProperties": false
        },
        "secret_source": {
          "type": "string",
          "enum": [
            "none",
            "env",
            "secret_manager",
            "workload_identity",
            "vault"
          ]
        },
        "tenant": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "client_cert_ref": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "client_key_ref": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "ca_ref": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "client_cert_ref",
            "client_key_ref"
          ],
          "additionalProperties": false
        },
        "provider": {
          "type": "object",
          "properties": {
            "token_endpoint": {
              "type": "string",
              "format": "uri"
            },
            "grant": {
              "type": "string",
              "enum": [
                "token_exchange",
                "client_credentials",
                "jwt_bearer"
              ]
            },
            "client_auth": {
              "type": "string",
              "enum": [
                "client_secret_basic",
                "client_secret_post",
                "private_key_jwt"
              ]
            },
            "resource": {
              "type": "string"
            },
            "subject_token_type": {
              "type": "string",
              "enum": [
                "access_token",
                "jwt",
                "id_token"
              ]
            },
            "requested_token_type": {
              "type": "string",
              "enum": [
                "access_token",
                "jwt",
                "id_token"
              ]
            },
            "api_key": {
              "type": "object",
              "properties": {
                "in": {
                  "type": "string",
                  "enum": [
                    "header",
                    "query"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "in",
                "name"
              ],
              "additionalProperties": false
            },
            "authorization_endpoint": {
              "type": "string",
              "format": "uri"
            },
            "pkce": {
              "type": "boolean"
            },
            "redirect_uri": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "path_grammar": {
      "type": "string",
      "enum": [
        "resource_grammar",
        "rpc_plain",
        "rpc_dotted",
        "adapter_lowered"
      ]
    },
    "operations": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "side_effect": {
            "type": "string",
            "enum": [
              "read",
              "mutation"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "financial",
              "destructive"
            ]
          },
          "reversible": {
            "type": "boolean"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "intent_examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "idempotency": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "natural",
                  "required_request_key",
                  "key_supported",
                  "client_id",
                  "none"
                ]
              },
              "key_location": {
                "type": "string",
                "enum": [
                  "header",
                  "query",
                  "body",
                  "path"
                ]
              },
              "header": {
                "type": "string"
              },
              "parameter": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "confirmation": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "risk": {
                "type": "string",
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high",
                  "financial",
                  "destructive"
                ]
              },
              "reason": {
                "type": "string"
              },
              "human_approval": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "action": {
            "type": "string",
            "enum": [
              "list",
              "get",
              "search",
              "export",
              "simulate",
              "validate",
              "poll",
              "create",
              "update",
              "replace",
              "delete",
              "send",
              "execute",
              "approve",
              "cancel",
              "reserve",
              "other"
            ]
          },
          "name": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string"
              },
              "verb": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "api_key",
                  "basic",
                  "oauth2_client_credentials",
                  "oauth2_authorization_code",
                  "oauth2_on_behalf_of",
                  "jwt_bearer",
                  "mtls",
                  "custom_header",
                  "workload_identity"
                ]
              },
              "credential_profile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z](?:[a-z0-9_]{0,62}[a-z0-9])?$"
              },
              "principal": {
                "type": "string",
                "enum": [
                  "anonymous",
                  "service",
                  "end_user",
                  "delegated",
                  "impersonation"
                ]
              },
              "issuer": {
                "type": "string",
                "format": "uri"
              },
              "audience": {
                "type": "string"
              },
              "carrier": {
                "type": "object",
                "properties": {
                  "in": {
                    "type": "string",
                    "enum": [
                      "header",
                      "query"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scheme": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "in",
                  "name"
                ],
                "additionalProperties": false
              },
              "secret_source": {
                "type": "string",
                "enum": [
                  "none",
                  "env",
                  "secret_manager",
                  "workload_identity",
                  "vault"
                ]
              },
              "tenant": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "tls": {
                "type": "object",
                "properties": {
                  "client_cert_ref": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "client_key_ref": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  },
                  "ca_ref": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]*$"
                  }
                },
                "required": [
                  "client_cert_ref",
                  "client_key_ref"
                ],
                "additionalProperties": false
              },
              "provider": {
                "type": "object",
                "properties": {
                  "token_endpoint": {
                    "type": "string",
                    "format": "uri"
                  },
                  "grant": {
                    "type": "string",
                    "enum": [
                      "token_exchange",
                      "client_credentials",
                      "jwt_bearer"
                    ]
                  },
                  "client_auth": {
                    "type": "string",
                    "enum": [
                      "client_secret_basic",
                      "client_secret_post",
                      "private_key_jwt"
                    ]
                  },
                  "resource": {
                    "type": "string"
                  },
                  "subject_token_type": {
                    "type": "string",
                    "enum": [
                      "access_token",
                      "jwt",
                      "id_token"
                    ]
                  },
                  "requested_token_type": {
                    "type": "string",
                    "enum": [
                      "access_token",
                      "jwt",
                      "id_token"
                    ]
                  },
                  "api_key": {
                    "type": "object",
                    "properties": {
                      "in": {
                        "type": "string",
                        "enum": [
                          "header",
                          "query"
                        ]
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "in",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  "authorization_endpoint": {
                    "type": "string",
                    "format": "uri"
                  },
                  "pkce": {
                    "type": "boolean"
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "retries": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "only_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max_attempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "additionalProperties": false
          },
          "query_policy": {
            "type": "object",
            "properties": {
              "query_param": {
                "type": "string"
              },
              "dialect": {
                "default": "ansi",
                "type": "string",
                "enum": [
                  "ansi",
                  "postgres",
                  "mysql",
                  "bigquery",
                  "snowflake",
                  "redshift",
                  "databricks"
                ]
              },
              "allowed_statements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "select",
                    "insert",
                    "update",
                    "delete",
                    "merge",
                    "call",
                    "explain",
                    "other"
                  ]
                }
              },
              "single_statement_only": {
                "type": "boolean"
              },
              "forbid_comments": {
                "type": "boolean"
              },
              "max_rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "allowed_tables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "posture": {
                "type": "string"
              }
            },
            "required": [
              "query_param"
            ],
            "additionalProperties": false
          },
          "query_schema": {
            "type": "object",
            "properties": {
              "tables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "columns": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "sensitivity": {
                            "type": "string",
                            "enum": [
                              "public",
                              "internal",
                              "sensitive",
                              "pii"
                            ]
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "example_queries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "intent": {
                      "type": "string"
                    },
                    "sql": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "intent",
                    "sql"
                  ],
                  "additionalProperties": false
                }
              },
              "glossary": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "term": {
                      "type": "string"
                    },
                    "definition": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "term",
                    "definition"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "async_contract": {
