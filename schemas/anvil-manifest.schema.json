                        "type": "object",
                        "properties": {
                          "scheme": {
                            "type": "string",
                            "const": "provider_sdk"
                          },
                          "provider": {
                            "type": "string",
                            "enum": [
                              "stripe",
                              "twilio",
                              "github",
                              "shopify"
                            ]
                          },
                          "secret_ref": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "scheme",
                          "provider",
                          "secret_ref"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "scheme": {
                            "type": "string",
                            "const": "remote_verify"
                          },
                          "provider": {
                            "type": "string",
                            "const": "paypal"
                          },
                          "verify_endpoint_ref": {
                            "type": "string"
                          },
                          "credential_ref": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "scheme",
                          "provider",
                          "verify_endpoint_ref",
                          "credential_ref"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "scheme": {
                            "type": "string",
                            "const": "oidc_jwt"
                          },
                          "header_name": {
                            "type": "string"
                          },
                          "expected_issuer": {
                            "type": "string"
                          },
                          "expected_audience_ref": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "scheme",
                          "header_name",
                          "expected_issuer",
                          "expected_audience_ref"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "operation",
                  "job_id_field",
                  "signature_verification"
