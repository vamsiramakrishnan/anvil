{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tools/**/*.mjs"],
      "project": ["scripts/**/*.mjs", "tools/**/*.mjs"]
    },
    "apps/docs": {
      "entry": ["src/shims/*.js", "scripts/*.mjs"]
    },
    "packages/console": {
      "entry": ["src/server/index.ts", "src/ui/main.tsx", "e2e/global-setup.ts", "e2e/*.spec.ts"]
    },
    "packages/design": {
      "entry": ["src/index.ts", "scripts/*.mjs"]
    },
    "packages/mcp-runtime": {
      "entry": ["src/serve.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "scripts/*.mjs"]
    }
  },
  "ignoreDependencies": ["@fontsource/hanken-grotesk", "@fontsource/jetbrains-mono"],
  "ignoreBinaries": ["mkfifo"]
}
