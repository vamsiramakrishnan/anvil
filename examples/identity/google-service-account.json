{
  "version": 1,
  "id": "gcp-service-account",
  "authentication": {
    "provider": "google_service_account",
    "issuer": "https://accounts.google.com",
    "audience": "https://SERVICE-REGION.run.app",
    "jwksUri": "https://www.googleapis.com/oauth2/v3/certs",
    "tokenType": "JWT"
  },
  "mapping": {
    "tenant": {
      "source": "fixed",
      "value": "enterprise"
    },
    "subjects": [
      "REPLACE_WITH_SERVICE_ACCOUNT_NUMERIC_ID"
    ],
    "upstreamScopes": [
      "payments.read"
    ]
  },
  "authorization": {
    "adapter": "rules",
    "rules": [
      {
        "id": "payments-read",
        "service": "payments",
        "operations": [
          "payments.payments.get"
        ],
        "effect": "allow"
      }
    ]
  }
}
