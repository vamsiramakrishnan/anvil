#!/bin/sh
# pre-push: the checks CI would fail first, in seconds, before the push.
#
# Installed by `pnpm install` (the `prepare` script points core.hooksPath at
# .githooks). It lints the files changed since origin/main with Biome and
# typechecks only the workspace packages those files belong to, so a
# one-package change costs a few seconds, not a CI round trip. Fix the
# failures and push again; do not push with --no-verify to get past one.
set -eu
cat > /dev/null # git sends the refs on stdin; the checks do not need them

cd "$(git rev-parse --show-toplevel)"

base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || true)
if [ -z "$base" ]; then
    exit 0 # nothing to compare against (a fresh clone with one commit)
fi

changed=$(git diff --name-only --diff-filter=ACMR "$base" HEAD)
if [ -z "$changed" ]; then
    exit 0
fi

# Biome only handles the file types its config includes; hand it those.
lintable=$(printf '%s\n' "$changed" | grep -E '\.(ts|tsx|js|mjs|cjs|json|jsonc)$' || true)
if [ -n "$lintable" ]; then
    # shellcheck disable=SC2086
    pnpm exec biome check $lintable
fi

# turbo's `[ref]` filter selects the packages with changes since the ref (not
# their dependents: a change to packages/air would otherwise typecheck the
# whole workspace, which is CI's job); `^build` in turbo.json builds their
# dependencies first, from turbo's cache after the first run.
pnpm exec turbo run typecheck --filter="[$base]" --output-logs=errors-only
